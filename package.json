{
  "name": "gamelogs-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Osobisty katalog i dziennik gier",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/copy-static.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "images:optimize": "node scripts/optimize-images.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write src vite.config.ts tsconfig.json tests/unit scripts/dev.mjs scripts/copy-static.mjs",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/database.test.mjs",
    "test:legacy": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
